// Provides a compact two-dimensional qualification and calibration example for Studio.
characterize studio_qualification {
  // Define the target and the complete two-dimensional operating grid.
  reference power = -10 dBm
  sweep frequency 2.40 GHz .. 2.50 GHz step 25 MHz
  sweep temperature -20 degC .. 80 degC step 20 deltaC

  // Name all measurements so later derivations and assertions are unambiguous.
  measure output_power = power
  measure evm_result = evm
  measure carrier_error = frequency_error
  derive power_error = output_power - reference.power

  // Apply qualification limits independently at each frequency-temperature point.
  assert abs(power_error) <= 1.5 dB
  assert evm_result <= 2 %
  assert abs(carrier_error) <= 20 kHz

  // Produce one correction for every point in both active sweep dimensions.
  derive calibration tx_power {
    correction = -power_error
    over frequency, temperature
  }
}
