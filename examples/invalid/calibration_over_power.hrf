// Demonstrates rejection of a calibration indexed by a measurement instead of its sweep.
characterize calibration_over_power {
  reference power = -10 dBm
  sweep frequency 2.40 GHz .. 2.50 GHz step 1 MHz
  measure power
  derive calibration tx_power {
    correction = reference.power - power
    // Invalid: `over` must name every active sweep, not a measurement result.
    over power
  }
}
